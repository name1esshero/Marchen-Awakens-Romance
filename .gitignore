# Build directories and generated ROMs (including the original reference ROM).
/build/
*.gba
*.sav
*.ss[0-9]
*.elf
*.o
*.a
*.map
*.d
*.4bpp
*.8bpp
*.lz

# Emulator screenshots dropped beside the ROM. Asset PNGs in subdirectories
# remain tracked source files.
/*.png

# Locally installed toolchain, including headers supplied by its installer.
/tools/agbcc/

# Python caches and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Local recovery snapshots and published/generated documentation outputs.
/backups/
/reports/
/graphics/index.html
/graphics/**/index.html
/sound/index.html

# Editor/OS temporary files.
/maps/editable/.editor-*
/maps/events/.editor-*
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# AI-agent tooling config (Cline rules/hooks/workflows, Claude Code
# settings, etc.) stays out of the repo entirely -- contributors run
# whatever agent, model, and conventions they prefer, and none of that is
# this project's call to make for them.
/.clinerules/
/.claude/
/.cline/

# Keep editable PNG/PAL/JSON sources, extracted .bin data, and assembly.
# Report snapshots are published separately; their generators stay tracked.
